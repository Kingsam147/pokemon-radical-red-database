# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>
MONGODB_DB=<database-name>

# Redis
REDIS_URL=redis://default:<password>@<host>:<port>

# Game data version — bump this (e.g. v2, v3) whenever MongoDB game data changes to bust client caches
DATA_VERSION=v1

# Box schema version — bump this whenever the Pokémon box document shape changes to bust all per-box Redis keys
BOX_SCHEMA_VERSION=1

# Cloudinary (asset storage) — only needed for the one-off migration script in
# Backend/scripts/migrateImagesToCloudinary.js; the app itself builds public
# delivery URLs from a hardcoded cloud name in Frontend/lib/utils/sprites.ts
CLOUDINARY_CLOUD_NAME=<your-cloudinary-cloud-name>
CLOUDINARY_API_KEY=<your-cloudinary-api-key>
CLOUDINARY_API_SECRET=<your-cloudinary-api-secret>

# Auth0 (Backend)
AUTH0_AUDIENCE=https://your-api-identifier
AUTH0_ISSUER_BASE_URL=https://your-tenant.auth0.com

# Guest identity
GUEST_COOKIE_SECRET=<generate-a-long-random-string>
CORS_ORIGIN=http://localhost:3000

# Sentry (Backend) — get DSN from https://sentry.io/settings/<org>/projects/<project>/keys/
SENTRY_DSN=https://<key>@<org>.ingest.us.sentry.io/<project-id>
SENTRY_ORG=<your-sentry-org-slug>
SENTRY_PROJECT=pokemon-radical-red
SENTRY_AUTH_TOKEN=<your-sentry-auth-token>

# Cloudflare
CLOUDFLARE_API_TOKEN=<your-cloudflare-api-token>
CLOUDFLARE_ACCOUNT_ID=<your-cloudflare-account-id>
